{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["electron", "scripts", "vite.config.ts", "tailwind.config.ts", "shared"],
  "exclude": ["scripts/e2e/sample-repo"]
}
