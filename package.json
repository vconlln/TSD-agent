{
  "name": "tsd-agent",
  "version": "1.2.0",
  "private": true,
  "description": "TSD Agent — 项目方案升级智能体（Electron + React + Python）",
  "author": {
    "name": "vconlln",
    "email": "96578937+vconlln@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5273 && cross-env NODE_ENV=development electron .\"",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "backend:dev": "node scripts/py.mjs server/main.py --port 8791",
    "backend:setup": "node scripts/py.mjs -m pip install -r server/requirements.txt",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "pack:backend:win": "node scripts/py.mjs -m PyInstaller --noconfirm server/tsd_server.spec",
    "pack:backend": "node scripts/py.mjs -m PyInstaller --noconfirm server/tsd_server.spec",
    "e2e": "node scripts/py.mjs scripts/e2e/run_e2e.py",
    "e2e:git": "node scripts/py.mjs scripts/e2e/run_git_e2e.py",
    "e2e:agent": "node scripts/py.mjs scripts/e2e/run_agent_e2e.py",
    "e2e:chat": "node scripts/py.mjs scripts/e2e/run_chat_e2e.py",
    "e2e:all": "npm run e2e && npm run e2e:git && npm run e2e:agent && npm run e2e:chat",
    "seed:demo": "node scripts/py.mjs scripts/seed_demo.py",
    "screenshots": "electron --no-sandbox --ozone-platform=headless --disable-gpu scripts/capture-screens.cjs",
    "icon": "node scripts/py.mjs scripts/make-icon.py",
    "assets:installer": "node scripts/py.mjs scripts/make-installer-assets.py",
    "verify:package": "node scripts/verify-packaged-app.mjs",
    "dist:installer": "node scripts/build-installer.mjs",
    "ui:check": "electron --no-sandbox --ozone-platform=headless --disable-gpu scripts/ui-check.cjs",
    "contract:check": "node scripts/contract-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "diff": "^5.2.0",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.451.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.4",
    "react-router-dom": "^6.27.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.22.2",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/diff": "^5.2.3",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
